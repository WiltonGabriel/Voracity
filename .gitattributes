# Normalize line endings across Linux and Windows contributors
* text=auto eol=lf

# Shell scripts must stay LF for Linux execution (play_linux.sh)
*.sh text eol=lf

# C#, .NET project files, JSON data & Godot scenes/shaders
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.ico binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
